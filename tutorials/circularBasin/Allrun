#!/bin/sh
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

restore0Dir

# Mesh: gmsh (https://gmsh.info) is needed for this case
gmsh -3 basin.geo -format msh2 -o basin.msh > log.gmsh 2>&1 || { echo "gmsh failed (see log.gmsh)"; exit 1; }
runApplication gmshToFoam basin.msh
runApplication nhSetWaves
runApplication NHFOAM
