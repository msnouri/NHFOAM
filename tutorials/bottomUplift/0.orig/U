FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    surface
    {
        type            zeroGradient;
    }
    bottom
    {
        type            nhMovingSlipVelocity;
        value           uniform (0 0 0);
    }
    left
    {
        type            slip;
    }
    right
    {
        type            slip;
    }
    frontAndBack
    {
        type            empty;
    }
}

