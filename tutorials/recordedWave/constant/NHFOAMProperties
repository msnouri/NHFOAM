FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      NHFOAMProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Free-surface (top) and bottom patches of the sigma mesh
surfacePatch    surface;
bottomPatch     bottom;

// Smallest water depth used to place the mesh points [m]
minDepth        1e-4;

stillWaterLevel 0;

pressureLocation interface;

gauges
{
    G0.5    (0.5 0.01 0);
    G4    (4 0.01 0);
    G8    (8 0.01 0);
    G12    (12 0.01 0);
}

forcingZones
{
    outlet
    {
        type        sponge;
        start       (15 0 0);
        end         (18 0 0);
        sigmaMax    20;
        exponent    2;
    }
}

