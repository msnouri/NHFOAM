// Hansen & Svendsen (1979), test 061071: regular waves (T = 1.667 s,
// H = 6.86 cm at the toe) shoal on a 1:34.26 slope from h = 0.36 m and break
// as spilling breakers around x = 8.2 m. x is measured from the toe of the
// slope. Without wetting and drying, the slope is cut at x = 11 m and
// continues as a shelf whose sponge damps the velocity only (relaxEta false),
// so that it does not drain water. Breaking: hydrostatic front approximation
// with limitedLinearV convection (system/fvSchemes).
// validation/plot_hansen_svendsen.py compares the wave heights with the lab
// data (fengyanshi/BENCHMARK_FUNWAVE, car_hansen_svendsen).

// Free-surface (top) and bottom patches of the sigma mesh
surfacePatch    surface;
bottomPatch     bottom;

// Smallest water depth used to place the mesh points [m]
minDepth        1e-4;

stillWaterLevel 0;

// Pressure unknowns on the layer interfaces, q = 0 on the free surface
// (as NHWAVE; the default), or at the cell centres: pressureLocation cell;
pressureLocation interface;

