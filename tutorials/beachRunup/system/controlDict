FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     NHFOAM;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         8.778622909;
deltaT          0.002;

writeControl    runTime;
writeInterval   0.73155191;   // 5 t*, t* = t sqrt(g/d)
purgeWrite      0;

writeFormat     ascii;
writePrecision  10;
writeCompression off;
timeFormat      general;
timePrecision   8;

runTimeModifiable true;

adjustTimeStep  no;
maxCo           0.5;
maxDeltaT       1;

// ************************************************************************* //
