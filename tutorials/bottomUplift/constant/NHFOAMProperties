FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      NHFOAMProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Tsunami generation by a bottom uplift (Hammack 1973 type): a 2b = 0.61 m
// wide block of the bottom rises by zeta0 = 0.5 mm with the exponential
// history 1 - exp(-1.11 t/tc), tc = 0.1 s, in h = 5 cm of water. Half domain:
// the left wall (x = 0) is the symmetry plane. Gauges at x/b = 0, 1, 5, 10,
// 20, 30. validation/plot_uplift.py compares them with linear potential
// theory. The bottom uses the nhMovingSlipVelocity condition for U.

// Free-surface (top) and bottom patches of the sigma mesh
surfacePatch    surface;
bottomPatch     bottom;

// Smallest water depth used to place the mesh points [m]
minDepth        1e-4;

stillWaterLevel 0;

// Pressure unknowns on the layer interfaces, q = 0 on the free surface
// (as NHWAVE; the default), or at the cell centres: pressureLocation cell;
pressureLocation interface;

gauges
{
    G0    (0 0.0025 0);
    G1    (0.305 0.0025 0);
    G2    (1.525 0.0025 0);
    G3    (3.05 0.0025 0);
    G4    (6.1 0.0025 0);
    G5    (9.15 0.0025 0);
}

bottomMotion
{
    type        uplift;
    min         (-0.305 -1 0);
    max         (0.305 1 0);
    amplitude   0.0005;
    history     exponential;
    riseTime    0.1;
}

forcingZones
{
    outlet
    {
        type        sponge;
        start       (12 0 0);
        end         (15 0 0);
        sigmaMax    5;
        exponent    2;
    }
}

