#!/bin/sh
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

# Solitary wave run-up on a 1:20 beach with wetting and drying
restore0Dir

runApplication blockMesh
runApplication nhSetWaves
runApplication NHFOAM

# maximum run-up R/d (lab: about 0.5)
if [ -f postProcessing/wettingDrying/0/shoreline.dat ]
then
    awk '!/^#/ {if ($3 > r) r = $3} END {printf "maximum run-up R/d = %.3f\n", r/0.21}' \
        postProcessing/wettingDrying/0/shoreline.dat
fi
