FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      NHFOAMProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Free-surface (top) and bottom patches of the sigma mesh
surfacePatch    surface;
bottomPatch     bottom;

// Smallest water depth used to place the mesh points [m]
minDepth        1e-4;

stillWaterLevel 0;

// Pressure unknowns on the layer interfaces, q = 0 on the free surface
// (as NHWAVE; the default), or at the cell centres: pressureLocation cell;
pressureLocation interface;

gauges
{
    G22    (22 0.01 0);
    G24    (24 0.01 0);
    G30.5    (30.5 0.01 0);
    G32.5    (32.5 0.01 0);
    G33.5    (33.5 0.01 0);
    G34.5    (34.5 0.01 0);
    G35.7    (35.7 0.01 0);
    G37.3    (37.3 0.01 0);
    G39    (39 0.01 0);
    G41    (41 0.01 0);
}

forcingZones
{
    inlet
    {
        type        wave;
        start       (8 0 0);
        end         (0 0 0);
        sigmaMax    20;
        exponent    2;
        waveHeight  0.02;
        wavePeriod  2.02;
        depth       0.4;
        direction   (1 0 0);
        rampTime    4.04;
    }
    outlet
    {
        type        sponge;
        start       (46 0 0);
        end         (54 0 0);
        sigmaMax    20;
        exponent    2;
    }
}

