#!/bin/sh
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

# Longshore current on a 1:20 beach: Visser (1991), case 4; test 4.7 of
# Ma, Shi & Kirby (2012).  Oblique stream-function waves (H = 7.8 cm,
# T = 1.02 s, 15.4 degrees at h = 0.35 m), periodic alongshore over one
# alongshore wavelength, breaking with the HFA and the breaking eddy
# viscosity, Smagorinsky subgrid model, log-law friction, wetting and drying.
# 48 000 cells, 100 s: about 1.5 h on one core.
restore0Dir

runApplication blockMesh
runApplication NHFOAM

# Profiles of wave height, mean level and depth-averaged longshore current
# against the measurements (validation/plot_longshore.py):
#   python3 <NHFOAM>/validation/plot_longshore.py longshore.png .:NHFOAM
