FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     NHFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         50;
deltaT          0.01;

writeControl    timeStep;
writeInterval   500;
purgeWrite      0;

writeFormat     ascii;
writePrecision  10;
writeCompression off;
timeFormat      general;
timePrecision   8;

runTimeModifiable true;

adjustTimeStep  no;
maxCo           0.5;
maxDeltaT       1;

