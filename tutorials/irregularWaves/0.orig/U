FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    surface
    {
        type            zeroGradient;
    }
    bottom
    {
        type            slip;
    }
    left
    {
        type            nhWaveVelocity;
        activeAbsorption yes;
        wave
        {
            theory      irregular;
            Hs          0.03;
            Tp          1.5;
            gamma       3.3;
            nFrequencies 100;
            seed        1;
            depth       0.4;
            direction   (1 0 0);
            rampTime    3;
        }
        value           uniform (0 0 0);
    }
    right
    {
        type            nhWaveVelocity;
        activeAbsorption yes;
        absorptionCelerity wave;
        wave
        {
            theory      linear;
            waveHeight  0;
            wavePeriod  1.5;
            depth       0.4;
            direction   (1 0 0);
            rampTime    3;
        }
        value           uniform (0 0 0);
    }
    frontAndBack
    {
        type            empty;
    }
}

