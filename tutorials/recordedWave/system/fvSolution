FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          PCG;
        preconditioner  sigmaColumn;
        tolerance       1e-10;
        relTol          0.01;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    "(U|UFinal)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-12;
        relTol          0;
    }

}

PIMPLE
{
    momentumPredictor         yes;
    nOuterCorrectors          1;
    nCorrectors               3;
    nNonOrthogonalCorrectors  0;
    moveMeshOuterCorrectors   false;
}

relaxationFactors
{
    equations
    {
        ".*"            1;
    }
}

